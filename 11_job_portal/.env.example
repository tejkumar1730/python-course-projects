# Copy to .env. MySQL is the normal project database.
DATABASE_ENGINE=mysql
MYSQL_DATABASE=job_portal
MYSQL_USER=portfolio
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# A deliberately optional quick demo: set DATABASE_ENGINE=sqlite.
