# Copy to .env and supply local values. Never commit .env.
DATABASE_ENGINE=mysql
MYSQL_DATABASE=product_api
MYSQL_USER=portfolio
MYSQL_PASSWORD=replace-with-your-local-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
